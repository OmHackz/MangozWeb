# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=https://mangoz-smp.pages.dev
NEXT_PUBLIC_JAVA_ADDRESS=play.mangoz-smp.pages.dev
NEXT_PUBLIC_BEDROCK_ADDRESS=play.mangoz-smp.pages.dev
NEXT_PUBLIC_BEDROCK_PORT=19132
# Live map (Squaremap). Baked-in default is http://mangozsmp.seedloaf.gg:51260/
# Set this only to override the default.
NEXT_PUBLIC_MAP_URL=
# Optional community links (only configured links are shown)
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Server-only (NEVER use NEXT_PUBLIC_ for these)
# Supabase Postgres (REQUIRED for live data — without it the site shows empty states)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY= (fallback if you prefer anon + RLS)

# Legacy / alternative: any Postgres-compatible URL (Neon, Supabase pooled, etc.)
# Only needed if you write your own SQL driver layer; Supabase REST above needs no driver.
DATABASE_URL=

# Protects POST /api/minecraft/* — generate with: openssl rand -hex 32
MINECRAFT_API_KEY=

# Protects POST /api/bot/status (falls back to MINECRAFT_API_KEY if unset)
BOT_API_KEY=

# Optional: bot's own dashboard URL (shown as a button on /bot)
NEXT_PUBLIC_BOT_DASHBOARD_URL=

# Optional: Discord webhook URL — the website POSTs a message here on every
# store order so staff can verify the UPI payment and grant the rank.
ORDER_WEBHOOK_URL=
